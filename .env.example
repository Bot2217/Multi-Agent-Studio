# Скопируйте в .env и вставьте только те ключи, которые используете.
# Файл .env не коммитится.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=

# Локальный Ollama. Ключ не нужен, адрес можно сменить.
OLLAMA_API_BASE=http://localhost:11434

# Необязательная модель по умолчанию для внешних скриптов
AGENT_MODEL=gemini/gemini-3.8-flash
