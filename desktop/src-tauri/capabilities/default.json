{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window of Улей",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "process:default",
    "updater:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "ulei-backend",
          "sidecar": true,
          "args": ["--port", { "validator": "\\d{1,5}" }]
        }
      ]
    }
  ]
}
