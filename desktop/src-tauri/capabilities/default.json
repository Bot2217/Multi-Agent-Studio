{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window of Улей",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "process:default",
    "updater:default",
    "allow-engine-health",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "ulei-backend",
          "sidecar": true,
          "args": [
            "--port",
            { "validator": "\\d{1,5}" },
            "--api-port",
            { "validator": "\\d{1,5}" }
          ]
        }
      ]
    }
  ]
}
