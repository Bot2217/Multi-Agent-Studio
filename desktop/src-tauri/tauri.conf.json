{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Улей",
  "mainBinaryName": "ulei",
  "version": "0.1.0",
  "identifier": "com.bot2217.ulei",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Улей",
        "width": 1200,
        "height": 800,
        "minWidth": 880,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:* 'unsafe-inline' 'unsafe-eval' blob: data:; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:* ipc: http://ipc.localhost; img-src 'self' data: blob: http://127.0.0.1:*; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "msi", "dmg"],
    "createUpdaterArtifacts": false,
    "externalBin": ["binaries/ulei-backend"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Улей — многоагентная студия",
    "longDescription": "Несколько ролей по очереди делают одну задачу. Окно программы, без браузера.",
    "windows": {
      "wix": {
        "language": "ru-RU"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFEMTk0QTIwODRGQTFBMjIKUldRaUd2cUVJRW9acmVUb0crR1R6U25Nc3g1OW14alcxSFU5blVWcmZqUmZEdzNJUnRBL0RFKy8K",
      "endpoints": [
        "https://github.com/Bot2217/Multi-Agent-Studio/releases/latest/download/latest.json"
      ]
    }
  }
}
